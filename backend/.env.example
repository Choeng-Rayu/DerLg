# ==================================================
# DerLg.com Backend — Environment Variables
# ==================================================
# Copy this file to .env and fill in the values.
# All variables are required unless marked (optional).

# --- Application ---
NODE_ENV=development
PORT=3001

# --- Supabase PostgreSQL (Prisma) ---
# Connection pooler URL (for runtime queries)
DATABASE_URL=postgresql://user:password@localhost:5432/derlg_dev?schema=public
# Direct connection URL (for migrations)
DIRECT_URL=postgresql://user:password@localhost:5432/derlg_dev?schema=public

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT ---
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Redis (Upstash or local) ---
REDIS_URL=redis://localhost:6379

# --- AI Service ---
AI_SERVICE_KEY=your-ai-service-key

# --- Resend (Email) ---
RESEND_API_KEY=re_xxx

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# --- ExchangeRate API (optional) ---
EXCHANGE_RATE_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
