# ==================================================
# DerLg.com Backend — Environment Example
# ==================================================
# Copy to .env and fill in values.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://derlg_user:derlg_dev_password@localhost:5432/derlg_dev?schema=public

JWT_ACCESS_SECRET=<min-32-char-secret>
JWT_REFRESH_SECRET=<min-32-char-secret>

REDIS_URL=redis://localhost:6379

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

AI_SERVICE_KEY=<min-16-char-key>

# Optional
# RESEND_API_KEY=re_xxx
# SENTRY_DSN=https://xxx@sentry.io/xxx
# EXCHANGE_RATE_API_KEY=xxx

CORS_ORIGINS=http://localhost:3000
